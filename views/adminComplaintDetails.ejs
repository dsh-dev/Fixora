<!DOCTYPE html>

<html>

<head>

<title>
Complaint Details
</title>

<link 
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

</head>


<body class="bg-light">


<div class="container mt-5">


<h1>
Complaint Details
</h1>


<hr>



<div class="card shadow p-4">


<h3>
<%= complaint.title %>
</h3>


<p>
<b>Student:</b>
<%= complaint.name %>
</p>


<p>
<b>Email:</b>
<%= complaint.email %>
</p>


<p>
<b>Room:</b>
<%= complaint.room_number %>
</p>


<p>
<b>Description:</b>
<%= complaint.description %>
</p>


<p>
<b>Status:</b>
<%= complaint.status %>
</p>



<% if(complaint.image){ %>


<h4>
Uploaded Image
</h4>


<img
src="/uploads/<%= complaint.image %>"
width="300"
>


<% } %>



<br><br>


<a href="/admin"
class="btn btn-dark">

Back

</a>



</div>


</div>


</body>

</html>