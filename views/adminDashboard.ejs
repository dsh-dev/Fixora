<!DOCTYPE html>

<html>

<head>

<title>
Admin Dashboard
</title>


<link 
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">


<link 
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
rel="stylesheet">


<style>

body{

background:#f5f7fb;

}


.sidebar{

min-height:100vh;

}


.stat-card{

border:none;
border-radius:18px;
transition:0.3s;

}


.stat-card:hover{

transform:translateY(-5px);

}


.table-card{

border:none;
border-radius:15px;

}


.ai-summary{

max-width:250px;

font-size:13px;

}


</style>


</head>



<body>



<nav class="navbar navbar-dark bg-dark">


<div class="container-fluid">


<span class="navbar-brand">

<i class="bi bi-shield-lock"></i>

AI Hostel Admin Panel

</span>


<a href="/logout"
class="btn btn-danger">

<i class="bi bi-box-arrow-right"></i>

Logout

</a>


</div>


</nav>





<div class="container-fluid">


<div class="row">



<!-- Sidebar -->


<div class="col-md-2 bg-dark sidebar p-3">


<div class="list-group">


<a href="/admin"
class="list-group-item list-group-item-action active">

<i class="bi bi-speedometer2"></i>

Dashboard

</a>



<a href="#complaints"
class="list-group-item list-group-item-action">

<i class="bi bi-file-text"></i>

Complaints

</a>



</div>


</div>






<!-- Main Content -->


<div class="col-md-10 p-4">



<h2>

Complaint Overview

</h2>


<p class="text-muted">

Manage student complaints using AI insights

</p>


<hr>





<!-- Statistics -->


<div class="row mb-4">



<div class="col-md-3">

<div class="card shadow stat-card text-center p-3">


<h5>

<i class="bi bi-list"></i>

Total

</h5>


<h1>

<%= total %>

</h1>


</div>

</div>





<div class="col-md-3">

<div class="card shadow stat-card text-center p-3">


<h5>

<i class="bi bi-hourglass"></i>

Pending

</h5>


<h1>

<%= pending %>

</h1>


</div>

</div>





<div class="col-md-3">

<div class="card shadow stat-card text-center p-3">


<h5>

<i class="bi bi-arrow-repeat"></i>

Processing

</h5>


<h1>

<%= inProgress %>

</h1>


</div>

</div>





<div class="col-md-3">

<div class="card shadow stat-card text-center p-3">


<h5>

<i class="bi bi-check-circle"></i>

Resolved

</h5>


<h1>

<%= resolved %>

</h1>


</div>

</div>


</div>








<!-- Search -->


<div class="card shadow p-3 mb-4">


<form action="/admin/search" method="GET">


<div class="input-group">


<input

type="text"

name="search"

class="form-control"

placeholder="Search complaint, student or room">


<button class="btn btn-primary">

<i class="bi bi-search"></i>

Search

</button>


<a href="/admin"
class="btn btn-secondary">

Clear

</a>


</div>


</form>


</div>









<!-- Complaints Table -->


<div class="card shadow table-card"
id="complaints">


<div class="card-body">


<h4>

<i class="bi bi-chat-left-text"></i>

Complaints

</h4>


<hr>




<div class="table-responsive">


<table class="table table-hover align-middle">


<thead class="table-dark">


<tr>


<th>
Title
</th>


<th>
Student
</th>


<th>
Room
</th>


<th>
Image
</th>


<th>
AI Category
</th>


<th>
AI Priority
</th>


<th>
AI Summary
</th>


<th>
Status
</th>


<th>
Action
</th>


</tr>


</thead>





<tbody>



<% complaints.forEach(function(c){ %>



<tr>



<td>

<b>

<%= c.title %>

</b>

<br>

<small>

<%= c.description %>

</small>

</td>





<td>

<%= c.name %>

<br>

<small>

<%= c.email %>

</small>

</td>






<td>

<%= c.room_number %>

</td>








<td>


<% if(c.image){ %>


<img

src="/uploads/<%= c.image %>"

width="80"

height="80"

class="rounded"

style="object-fit:cover;">


<% } else { %>


<span class="text-muted">

No Image

</span>


<% } %>



</td>








<!-- AI CATEGORY -->

<td>


<span class="badge bg-info">

<%= c.ai_category || "Not Available" %>

</span>


</td>






<!-- AI PRIORITY -->


<td>


<%

let color="secondary";


if(c.ai_priority=="Critical"){

color="danger";

}

else if(c.ai_priority=="High"){

color="warning";

}

else if(c.ai_priority=="Medium"){

color="primary";

}

else if(c.ai_priority=="Low"){

color="success";

}

%>


<span class="badge bg-<%= color %>">

<%= c.ai_priority || "Not Available" %>

</span>


</td>







<!-- AI SUMMARY -->


<td>


<div class="ai-summary">


<%= c.summary || "No AI summary" %>


</div>


</td>








<!-- STATUS -->


<td>



<% if(c.status=="Pending"){ %>


<span class="badge bg-warning text-dark">

Pending

</span>


<% } else if(c.status=="In Progress"){ %>


<span class="badge bg-primary">

In Progress

</span>


<% } else { %>


<span class="badge bg-success">

Resolved

</span>


<% } %>


</td>







<!-- ACTION -->


<td>



<a

href="/admin/complaint/<%= c.id %>"

class="btn btn-outline-primary btn-sm mb-2">


<i class="bi bi-eye"></i>

View


</a>








<form action="/admin/update-status"
method="POST">


<input

type="hidden"

name="complaint_id"

value="<%= c.id %>">





<select

name="status"

class="form-select form-select-sm mb-2">


<option>
Pending
</option>


<option>
In Progress
</option>


<option>
Resolved
</option>


</select>







<button class="btn btn-dark btn-sm">

Update

</button>


</form>


</td>



</tr>



<% }) %>



</tbody>


</table>


</div>



</div>


</div>





</div>


</div>


</div>





<script 
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


</body>


</html>