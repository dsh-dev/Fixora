rel="stylesheet">


<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}


body{

    font-family:'Segoe UI',sans-serif;

    background:#f8fafc;

}



/* =========================
   NAVBAR
========================= */


.navbar{

    position:fixed;

    top:0;

    width:100%;

    z-index:100;

    background: #1e3a8a!important;

    box-shadow:0 4px 15px rgba(0,0,0,0.15);

}


.navbar-brand{

    font-size:26px;

    font-weight:700;

    color:white!important;

}


.navbar .btn-primary{

    background:#2563eb;

    border:none;

}


.navbar .btn-outline-primary{

    color:white;

    border-color:white;

}


.navbar .btn-outline-primary:hover{

    background:white;

    color:#2563eb;

}


/* =========================
   HERO SECTION
========================= */


.hero{


    min-height:85vh;


    display:flex;


    align-items:center;


    position:relative;


    overflow:hidden;


    color:white;


}






/* Background Image */


.hero::before{


    content:"";


    position:absolute;


    inset:0;



    background-image:

    url("https://images.unsplash.com/photo-1562774053-701939374585");



    background-size:cover;


    background-position:center;



    filter:blur(4px);


    transform:scale(1.08);


    z-index:-2;


}





/* Dark Overlay */


.hero::after{


    content:"";


    position:absolute;


    inset:0;



    background:


    linear-gradient(

    90deg,

    rgba(15,23,42,0.85),

    rgba(37,99,235,0.45)

    );



    z-index:-1;


}







/* Hero Content */


.hero-content{


    max-width:650px;


}




.hero h1{


    font-size:58px;


    font-weight:800;


    line-height:1.15;


    text-shadow:

    0 5px 20px rgba(0,0,0,0.4);


}




.hero p{


    margin-top:25px;


    font-size:20px;


    line-height:1.8;


    color:#f1f5f9;


}





.hero .btn{


    margin-top:25px;


    padding:14px 35px;


    border-radius:50px;


    font-weight:600;


}





/* =========================
   FEATURES
========================= */


.feature-card{


    border:none;

    border-radius:25px;

    padding:35px;

    background:white;

    transition:.3s;

}



.feature-card:hover{


    transform:translateY(-10px);


    box-shadow:

    0 20px 40px rgba(0,0,0,.12);


}




.icon-box{


    width:75px;

    height:75px;

    border-radius:20px;

    display:flex;

    align-items:center;

    justify-content:center;

    background:#dbeafe;

    color:#2563eb;

    font-size:32px;


}





/* =========================
   PROCESS
========================= */


.process-card{


    border:none;


    border-radius:20px;


}





/* =========================
   CTA
========================= */


.cta{


    background:

    linear-gradient(

    135deg,

    #1e3a8a,

    #2563eb

    );


    color:white;


}





/* =========================
   FOOTER
========================= */


footer{


    background:#020617;

    color:white;


}







/* Responsive */


@media(max-width:992px){


.hero h1{


    font-size:42px;


}



.hero p{


    font-size:18px;


}


}



</style>

