<!DOCTYPE html>
<html>

<head>

<title>Complaint Details</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
rel="stylesheet">

<style>

body{
    background:#f5f7fb;
}

.details-card{
    border:none;
    border-radius:20px;
}

.complaint-image{
    width:100%;
    border-radius:12px;
    border:1px solid #ddd;
    object-fit:cover;
}

.ai-card{
    border:none;
    border-radius:15px;
}

</style>

</head>

<body>

<!-- Navbar -->

<nav class="navbar navbar-dark bg-dark">

<div class="container-fluid">

<span class="navbar-brand">

<i class="bi bi-house-door-fill"></i>

AI Hostel System

</span>

<a
href="/my-complaints"
class="btn btn-outline-light">

<i class="bi bi-arrow-left"></i>

Back

</a>

</div>

</nav>





<div class="container mt-5">

<div class="row justify-content-center">

<div class="col-lg-8">

<div class="card shadow details-card">

<div class="card-body p-4">

<h2>

<i class="bi bi-file-earmark-text"></i>

Complaint Details

</h2>

<hr>





<h3>

<%= complaint.title %>

</h3>

<br>





<p>

<strong>

<i class="bi bi-tags"></i>

Category:

</strong>

<%= complaint.category || "Not Assigned" %>

</p>





<p>

<strong>

<i class="bi bi-flag"></i>

Priority:

</strong>

<%= complaint.priority || "Not Assigned" %>

</p>





<p>

<strong>

<i class="bi bi-check-circle"></i>

Status:

</strong>

<% if(complaint.status=="Pending"){ %>

<span class="badge bg-warning text-dark">

Pending

</span>

<% } else if(complaint.status=="In Progress"){ %>

<span class="badge bg-primary">

In Progress

</span>

<% } else { %>

<span class="badge bg-success">

Resolved

</span>

<% } %>

</p>





<p>

<strong>

<i class="bi bi-calendar-event"></i>

Submitted:

</strong>

<%= complaint.created_at %>

</p>





<hr>

<h5>

<i class="bi bi-card-text"></i>

Description

</h5>

<p>

<%= complaint.description %>

</p>





<% if(complaint.image){ %>

<hr>

<h5>

<i class="bi bi-image"></i>

Uploaded Image

</h5>

<img
src="/uploads/<%= complaint.image %>"
class="complaint-image">

<% } %>





<!-- AI Analysis -->

<hr>

<div class="card shadow ai-card border-primary">

<div class="card-header bg-primary text-white">

<i class="bi bi-robot"></i>

AI Analysis

</div>

<div class="card-body">

<div class="row">

<div class="col-md-6">

<p>

<strong>AI Category</strong>

</p>

<span class="badge bg-info fs-6">

<%= complaint.ai_category || "Not Available" %>

</span>

</div>

<div class="col-md-6">

<p>

<strong>AI Priority</strong>

</p>

<%

let color="secondary";

if(complaint.ai_priority=="Critical"){

color="danger";

}

else if(complaint.ai_priority=="High"){

color="warning";

}

else if(complaint.ai_priority=="Medium"){

color="primary";

}

else{

color="success";

}

%>

<span class="badge bg-<%= color %> fs-6">

<%= complaint.ai_priority || "Not Available" %>

</span>

</div>

</div>

<hr>

<h6>

AI Summary

</h6>

<div class="alert alert-light border">

<%= complaint.summary || "No AI summary available." %>

</div>

</div>

</div>





<div class="mt-4">

<a
href="/my-complaints"
class="btn btn-secondary">

<i class="bi bi-arrow-left"></i>

Back to My Complaints

</a>

</div>

</div>

</div>

</div>

</div>

</div>





<script
src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>

</body>

</html>